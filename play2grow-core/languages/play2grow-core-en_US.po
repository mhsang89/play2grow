msgstr "— Not selected —"

#: includes/contact-form.php:537
msgid "Anh/chị cần Play2Grow hỗ trợ điều gì? (không bắt buộc)"
msgstr "How can Play2Grow help you? (optional)"

#: includes/contact-form.php:539
msgid "Vui lòng không ghi họ tên đầy đủ, ảnh hay thông tin nhận dạng của trẻ."
msgstr ""
"Please don’t include your child’s full name, photos or other identifying "
"details."

#: includes/contact-form.php:549
msgid "Gửi thông tin"
msgstr "Send my details"

#: includes/contact-form.php:596
msgid "Đang gửi…"
msgstr "Sending…"

#: includes/contact-form.php:597
msgid "Không gửi được do lỗi kết nối. Vui lòng kiểm tra mạng và thử lại."
msgstr ""
"Could not send because of a connection error. Please check your connection "
"and try again."

#: includes/contact-form.php:598
msgid "Vui lòng điền thông tin này."
msgstr "Please fill in this field."

#: includes/contact-form.php:599
msgid "Họ và tên cần từ 2 đến 80 ký tự."
msgstr "Your name should be 2 to 80 characters."

#: includes/contact-form.php:601
msgid "Số điện thoại chưa đúng định dạng (ví dụ: 0912 345 678)."
msgstr "The phone number is not in a valid format (e.g. 0912 345 678)."

#: includes/customizer.php:20
msgid "Play2Grow – Thông tin doanh nghiệp"
msgstr "Play2Grow – Company details"

#: includes/customizer.php:21
msgid ""
