msgid "Họ và tên cần từ 2 đến 80 ký tự và chỉ gồm chữ cái."
msgstr "Your name should be 2 to 80 characters and contain only letters."

#: includes/contact-form.php:154 includes/contact-form.php:600
msgid ""
"Vui lòng nhập số điện thoại hoặc email để Play2Grow có thể liên hệ lại."
msgstr ""
"Please enter a phone number or email so Play2Grow can get back to you."

#: includes/contact-form.php:159
