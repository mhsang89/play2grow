msgstr ""
"The phone number is not in a valid Vietnamese format (e.g. 0912 345 678)."

#: includes/contact-form.php:165 includes/contact-form.php:602
msgid "Email chưa đúng định dạng (ví dụ: ten@email.com)."
msgstr "The email address is not valid (e.g. name@email.com)."

